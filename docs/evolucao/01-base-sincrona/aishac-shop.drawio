        <mxCell id="state-order-t5" value="cancelar&lt;br&gt;(devolve estoque)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-CREATED" target="state-order-CANCELLED">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t6" value="cancelar&lt;br&gt;(devolve estoque)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-AWAITING_PAYMENT" target="state-order-CANCELLED">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t7" value="cancelar após pagamento?&lt;br&gt;(a definir na spec F01-040)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1" source="state-order-PAID" target="state-order-CANCELLED">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-note" value="Transição inválida (ex.: SHIPPED → CANCELLED) é recusada pelo domínio com erro do catálogo.&lt;br&gt;DELIVERED e CANCELLED são estados finais." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="700" y="420" width="420" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="state-customer" name="Máquina de estados — Cliente">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="state-customer-title" value="Máquina de estados — Cliente — Fase 01 (Base síncrona)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-subtitle" value="Implementado no F01-020 (RN-06, RN-07). Transições validadas em CustomerRules.ensureCanTransition; status em VARCHAR + ck_customers_status. Sem exclusão física (ADR-016)." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="20" y="40" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="60" y="215" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-ACTIVE" value="ACTIVE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#85BBF0;strokeColor=#5D82A8;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="180" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-BLOCKED" value="BLOCKED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#85BBF0;strokeColor=#5D82A8;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="620" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-INACTIVE" value="INACTIVE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="420" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="465" y="560" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-t0" value="cadastro&lt;br&gt;POST /customers" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-customer-start" target="state-customer-ACTIVE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-t1" value="block (com motivo)&lt;br&gt;grava block_reason e blocked_at" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="state-customer-ACTIVE" target="state-customer-BLOCKED">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-t2" value="unblock&lt;br&gt;limpa block_reason e blocked_at" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" parent="1" edge="1" source="state-customer-BLOCKED" target="state-customer-ACTIVE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-t3" value="deactivate&lt;br&gt;grava deactivated_at" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-customer-ACTIVE" target="state-customer-INACTIVE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-t4" value="deactivate&lt;br&gt;grava deactivated_at, limpa bloqueio" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-customer-BLOCKED" target="state-customer-INACTIVE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-t5" value="final na fase 01" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-customer-INACTIVE" target="state-customer-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-customer-note" value="Transição fora do diagrama (ex.: INACTIVE → ACTIVE, ACTIVE → ACTIVE) → 409 INVALID_STATUS_TRANSITION.&lt;br&gt;Cliente INACTIVE não altera dados nem endereços → 422 CUSTOMER_INACTIVE (RN-08).&lt;br&gt;Coerência no banco: ck_customers_block_data e ck_customers_deactivation_data.&lt;br&gt;Só ACTIVE faz pedido (RN-10): o order-data devolve o status real e quem recusa é o sales-service (F01-040)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="700" y="400" width="520" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
