        <mxCell id="seq-images-m2" value="falha rápida: produto existe? abaixo do limite?&lt;br&gt;tamanho (IMAGE_TOO_LARGE) e magic number (INVALID_IMAGE_TYPE)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;align=left;" parent="1" edge="1">
