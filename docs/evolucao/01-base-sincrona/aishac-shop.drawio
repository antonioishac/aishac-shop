  <diagram id="seq-images" name="Sequência — Imagens (inserir, substituir, excluir)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="seq-images-title" value="Sequência — Imagens (inserir, substituir, excluir) — Fase 01 (Base síncrona)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="seq-images-subtitle" value="sales-service implementado no F01-030 (ProductImageServiceImpl; ADR-010); web e web-bff planejados (F01-052). Banco guarda a chave; S3 sempre fora da transação; substituição grava chave nova; exclusão: banco primeiro, S3 depois." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="20" y="40" width="1300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="seq-images-ll-web" value="/admin (web)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" parent="1" vertex="1">
          <mxGeometry x="40" y="80" width="150" height="1240" as="geometry" />
        </mxCell>
        <mxCell id="seq-images-ll-bff" value="web-bff" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" parent="1" vertex="1">
          <mxGeometry x="260" y="80" width="150" height="1240" as="geometry" />
        </mxCell>
        <mxCell id="seq-images-ll-sales" value="sales-service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" parent="1" vertex="1">
          <mxGeometry x="480" y="80" width="150" height="1240" as="geometry" />
        </mxCell>
        <mxCell id="seq-images-ll-db" value="aishac_sales" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#2E7D32;fontColor=#ffffff;strokeColor=#1B5E20;" parent="1" vertex="1">
          <mxGeometry x="700" y="80" width="150" height="1240" as="geometry" />
        </mxCell>
        <mxCell id="seq-images-ll-s3" value="S3 / LocalStack" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;" parent="1" vertex="1">
          <mxGeometry x="920" y="80" width="150" height="1240" as="geometry" />
        </mxCell>
        <mxCell id="seq-images-note-cb" value="&lt;b&gt;Toda chamada ao S3&lt;/b&gt; (PutObject, DeleteObject) passa pelo Circuit Breaker &lt;b&gt;s3&lt;/b&gt; do Resilience4j; retry com backoff e timeouts (10 s por tentativa, 30 s no total) são do AWS SDK (ADR-009, emenda de 2026-10-13).&lt;br&gt;Falha ou circuito aberto no PutObject → &lt;b&gt;503 IMAGE_STORAGE_UNAVAILABLE&lt;/b&gt;, nada gravado no banco.&lt;br&gt;URL pré-assinada: calculada localmente pelo S3Presigner (sem chamada ao S3), com o &lt;i&gt;public-endpoint&lt;/i&gt; acessível pelo navegador." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="1190" y="138" width="440" height="160" as="geometry" />
        </mxCell>
        <mxCell id="seq-images-block-0" value="Inserir" style="text;html=1;fontStyle=1;fontSize=13;align=left;fillColor=#EEEEEE;" parent="1" vertex="1">
          <mxGeometry x="20" y="138" width="1150" height="24" as="geometry" />
        </mxCell>
        <mxCell id="seq-images-m0" value="POST /api/v1/admin/products/{id}/images (multipart)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115.0" y="200" as="sourcePoint" />
            <mxPoint x="335.0" y="200" as="targetPoint" />
          </mxGeometry>
