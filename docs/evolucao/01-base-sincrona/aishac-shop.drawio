          <mxGeometry x="650" y="480" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="comp-customer-map" value="&lt;b&gt;CustomerMapper&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[MapStruct]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;toResponse, toOrderData, copyAddress&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D82A8;" parent="1" vertex="1">
