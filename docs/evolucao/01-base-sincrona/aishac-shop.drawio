          <mxGeometry x="20" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="deploy-local-subtitle" value="infra/docker/compose.infra.yml + compose.apps.yml (include). Executado pelo usuário. Portas presas a 127.0.0.1." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="20" y="40" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="deploy-local-host" value="Máquina do desenvolvedor (Windows + Docker Desktop)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="30" y="80" width="1300" height="760" as="geometry" />
        </mxCell>
        <mxCell id="deploy-local-net" value="Rede Docker aishac-net (DNS por nome de serviço — ADR-019)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="120" width="1240" height="560" as="geometry" />
