  <diagram id="comp-sales" name="Componentes — sales-service">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="comp-sales-title" value="Componentes — sales-service — Fase 01 (Base síncrona)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="comp-sales-subtitle" value="Catálogo implementado no F01-030: pacote com.aishac.sales.catalog, camadas por tipo dentro do módulo (ADR-025 + ADR-026). order/ e payment/ ainda planejados (F01-040, F01-046); web-bff ainda não existe (F01-052)." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
