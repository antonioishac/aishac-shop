        <mxCell id="comp-customer-jpa" value="&lt;b&gt;CustomerRepository&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[JpaRepository + JpaSpecificationExecutor]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;findWithAddressesById (@EntityGraph); findForAddressChange (PESSIMISTIC_FORCE_INCREMENT)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D82A8;" parent="1" vertex="1">
