        <mxCell id="state-order-t1" value="iniciar pagamento" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-CREATED" target="state-order-AWAITING_PAYMENT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t2" value="pagamento aprovado" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-AWAITING_PAYMENT" target="state-order-PAID">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t2r" value="pagamento recusado&lt;br&gt;(nova tentativa)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-AWAITING_PAYMENT" target="state-order-AWAITING_PAYMENT">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-order-t3" value="admin: enviar" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-PAID" target="state-order-SHIPPED">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t4" value="admin: entregar" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-SHIPPED" target="state-order-DELIVERED">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t5" value="cancelar&lt;br&gt;(devolve estoque)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-CREATED" target="state-order-CANCELLED">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t6" value="cancelar&lt;br&gt;(devolve estoque)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-AWAITING_PAYMENT" target="state-order-CANCELLED">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t7" value="cancelar após pagamento?&lt;br&gt;(a definir na spec F01-040)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1" source="state-order-PAID" target="state-order-CANCELLED">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-note" value="Transição inválida (ex.: SHIPPED → CANCELLED) é recusada pelo domínio com erro do catálogo.&lt;br&gt;DELIVERED e CANCELLED são estados finais." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="700" y="420" width="420" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
