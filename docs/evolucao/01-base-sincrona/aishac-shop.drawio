  <diagram id="comp-customer" name="Componentes — customer-service">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="comp-customer-title" value="Componentes — customer-service — Fase 01 (Base síncrona)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="comp-customer-subtitle" value="Implementado no F01-020 (camadas por tipo, ADR-025): pacote com.aishac.customer. O serviço não chama outros serviços; web-bff e sales-service são consumidores ainda não implementados." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="20" y="40" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="comp-customer-consumers" value="&lt;b&gt;web-bff&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container · consumidor planejado, F01-052]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Telas de cliente e endereços (loja e /admin)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" parent="1" vertex="1">
          <mxGeometry x="150" y="80" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="comp-customer-sales" value="&lt;b&gt;sales-service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container · consumidor planejado, F01-040]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Contrato produtor do order-data no F01-025 (Spring Cloud Contract)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" parent="1" vertex="1">
          <mxGeometry x="600" y="80" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="comp-customer-feature" value="controller/ — @RestController, sem regra de negócio" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="170" width="900" height="120" as="geometry" />
        </mxCell>
        <mxCell id="comp-customer-ctrl" value="&lt;b&gt;CustomerController&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[controller]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;/api/v1/customers: listar, buscar, criar, atualizar, block, unblock, deactivate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D82A8;" parent="1" vertex="1">
          <mxGeometry x="55" y="200" width="280" height="75" as="geometry" />
        </mxCell>
        <mxCell id="comp-customer-ctrl-addr" value="&lt;b&gt;CustomerAddressController&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[controller]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;/api/v1/customers/{customerId}/addresses: listar, criar, atualizar, remover, definir padrão&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D82A8;" parent="1" vertex="1">
          <mxGeometry x="350" y="200" width="280" height="75" as="geometry" />
        </mxCell>
        <mxCell id="comp-customer-ctrl-order" value="&lt;b&gt;CustomerOrderDataController&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[controller]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;GET /api/v1/customers/{customerId}/order-data?addressId=...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D82A8;" parent="1" vertex="1">
          <mxGeometry x="645" y="200" width="280" height="75" as="geometry" />
        </mxCell>
        <mxCell id="comp-customer-service" value="service/ (interfaces e helpers) + service/impl/ (package-private, @Transactional)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="320" width="900" height="130" as="geometry" />
        </mxCell>
        <mxCell id="comp-customer-uc" value="&lt;b&gt;CustomerService → CustomerServiceImpl&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[service]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Cadastro, atualização (version), bloqueio, desbloqueio, desativação; dados para pedido&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D82A8;" parent="1" vertex="1">
          <mxGeometry x="55" y="350" width="280" height="85" as="geometry" />
