        </mxCell>
        <mxCell id="seq-create-order-ll-sales" value="sales-service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" parent="1" vertex="1">
          <mxGeometry x="480" y="80" width="150" height="860" as="geometry" />
        </mxCell>
        <mxCell id="seq-create-order-ll-customer" value="customer-service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" parent="1" vertex="1">
          <mxGeometry x="700" y="80" width="150" height="860" as="geometry" />
        </mxCell>
        <mxCell id="seq-create-order-ll-db" value="aishac_sales" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#2E7D32;fontColor=#ffffff;strokeColor=#1B5E20;" parent="1" vertex="1">
          <mxGeometry x="920" y="80" width="150" height="860" as="geometry" />
        </mxCell>
        <mxCell id="seq-create-order-m0" value="1. POST /api/v1/store/checkout&lt;br&gt;Idempotency-Key, itens (productId, quantity)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115.0" y="170" as="sourcePoint" />
            <mxPoint x="335.0" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-create-order-m1" value="2. POST /api/v1/orders&lt;br&gt;Idempotency-Key, X-Correlation-Id" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335.0" y="230" as="sourcePoint" />
            <mxPoint x="555.0" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-create-order-m2" value="3. Chave já usada? (restrição única)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="555.0" y="290" as="sourcePoint" />
            <mxPoint x="995.0" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-create-order-m3" value="pedido existente → devolve o mesmo (fim)" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="995.0" y="350" as="sourcePoint" />
            <mxPoint x="555.0" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-create-order-m4" value="4. GET /api/v1/customers/{customerId}/order-data?addressId=...&lt;br&gt;[Circuit Breaker · Retry · TimeLimiter]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="555.0" y="410" as="sourcePoint" />
            <mxPoint x="775.0" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-create-order-m5" value="5. 200 OrderDataResponse: status real +&lt;br&gt;shippingAddress (informado, padrão ou null)" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="775.0" y="470" as="sourcePoint" />
            <mxPoint x="555.0" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-create-order-m6" value="5'. falha ou circuito aberto → 503 ProblemDetail" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;dashed=1;strokeColor=#C62828;fontColor=#C62828;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="555.0" y="530" as="sourcePoint" />
            <mxPoint x="335.0" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-create-order-m7" value="6. BEGIN · trava produtos em ordem crescente de ID&lt;br&gt;UPDATE estoque WHERE stock_quantity &gt;= qty" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="555.0" y="590" as="sourcePoint" />
            <mxPoint x="995.0" y="590" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-create-order-m8" value="7. INSERT order + itens (snapshot de preço e endereço)&lt;br&gt;+ order_status_history · COMMIT" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="555.0" y="650" as="sourcePoint" />
            <mxPoint x="995.0" y="650" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-create-order-m9" value="8. 201 Created (total calculado no servidor)" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="555.0" y="710" as="sourcePoint" />
            <mxPoint x="335.0" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-create-order-m10" value="9. 201 dados da tela de confirmação" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335.0" y="770" as="sourcePoint" />
            <mxPoint x="115.0" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-create-order-m11" value="9'. 503 ProblemDetail → mensagem amigável" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;dashed=1;strokeColor=#C62828;fontColor=#C62828;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335.0" y="830" as="sourcePoint" />
            <mxPoint x="115.0" y="830" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-create-order-note" value="Estoque insuficiente → ROLLBACK e 409/422 ProblemDetail (INSUFFICIENT_STOCK).&lt;br&gt;Mesma Idempotency-Key em paralelo → só 1 pedido (teste F01-049).&lt;br&gt;order-data (já implementado no customer-service, F01-020): devolve o status real e quem recusa cliente não ACTIVE é o sales-service (RN-10); shippingAddress nulo, o sales-service decide (RN-17). 404 CUSTOMER_NOT_FOUND / ADDRESS_NOT_FOUND e o tratamento no sales-service ficam na spec F01-040." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="1150" y="520" width="380" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
