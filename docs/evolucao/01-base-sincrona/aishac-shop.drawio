        <mxCell id="seq-images-m1" value="POST /api/v1/products/{productId}/images&lt;br&gt;(multipart: file + altText)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
