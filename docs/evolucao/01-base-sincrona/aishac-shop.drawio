        <mxCell id="comp-customer-svc-addr" value="&lt;b&gt;CustomerAddressService → CustomerAddressServiceImpl&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[service]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Endereços (RN-11 a RN-15); toda alteração trava o cliente&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D82A8;" parent="1" vertex="1">
