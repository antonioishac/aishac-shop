        <mxCell id="comp-customer-spec" value="&lt;b&gt;CustomerSpecifications&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[JPA Specification]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;withFilters(name, email, cpf, status) da listagem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D82A8;" parent="1" vertex="1">
