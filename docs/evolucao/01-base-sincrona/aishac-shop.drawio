          <mxGeometry x="60" y="215" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="state-order-CREATED" value="CREATED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#85BBF0;strokeColor=#5D82A8;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="140" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state-order-AWAITING_PAYMENT" value="AWAITING_PAYMENT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#85BBF0;strokeColor=#5D82A8;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="200" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state-order-PAID" value="PAID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#85BBF0;strokeColor=#5D82A8;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="680" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state-order-SHIPPED" value="SHIPPED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#85BBF0;strokeColor=#5D82A8;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="940" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state-order-DELIVERED" value="DELIVERED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1200" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state-order-CANCELLED" value="CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="420" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t0" value="pedido criado" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-start" target="state-order-CREATED">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t1" value="iniciar pagamento" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-CREATED" target="state-order-AWAITING_PAYMENT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t2" value="pagamento aprovado" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-AWAITING_PAYMENT" target="state-order-PAID">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t2r" value="pagamento recusado&lt;br&gt;(nova tentativa)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-AWAITING_PAYMENT" target="state-order-AWAITING_PAYMENT">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-order-t3" value="admin: enviar" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-PAID" target="state-order-SHIPPED">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-order-t4" value="admin: entregar" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="state-order-SHIPPED" target="state-order-DELIVERED">
          <mxGeometry relative="1" as="geometry" />
