        <mxCell id="1" parent="0" />
        <mxCell id="state-order-title" value="Máquina de estados — Pedido — Fase 01 (Base síncrona)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="state-order-subtitle" value="Planejado (F01-045, padrão State). Toda transição grava order_status_history. Cancelamento devolve o estoque na mesma transação." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
