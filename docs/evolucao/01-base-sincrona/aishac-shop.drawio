          <mxGeometry x="20" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="seq-create-order-subtitle" value="Planejado (F01-040 a F01-043). Preço e total calculados no servidor (ADR-014); idempotência no banco (ADR-017); falha do customer-service vira 503 (ADR-009)." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
