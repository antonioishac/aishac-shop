        <mxCell id="seq-images-m10" value="após o COMMIT: DeleteObject (chave antiga)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" parent="1" edge="1">
