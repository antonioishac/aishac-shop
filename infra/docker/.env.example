# Copie para infra/docker/.env e preencha com os SEUS valores. O .env nunca é versionado.
# As senhas dos bancos só são aplicadas na primeira criação do volume do PostgreSQL;
# para trocá-las depois, recrie o volume (ver README.md).

# PostgreSQL
POSTGRES_SUPERUSER_PASSWORD=
CUSTOMER_DB_PASSWORD=
SALES_DB_PASSWORD=
CLAUDE_MCP_DB_PASSWORD=
POSTGRES_PORT=5432

# LocalStack (plano Hobby — F01-018)
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_PORT=4566

# AWS / S3 local
AWS_REGION=us-east-1
PRODUCT_IMAGES_BUCKET=aishac-product-images-local
